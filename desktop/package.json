{
  "name": "vybe-desktop",
  "productName": "VYBE",
  "version": "0.2.0",
  "description": "VYBE para Windows: o app de música e vídeos como programa instalável",
  "author": "Cauan-Silva",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.cauan.vybe",
    "productName": "VYBE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "ambiente.js",
      "discord.js"
    ],
    "extraResources": [
      {
        "from": "build/jre",
        "to": "jre"
      },
      {
        "from": "build/vybe-api.jar",
        "to": "vybe-api.jar"
      },
      {
        "from": "build/frontend",
        "to": "frontend"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VYBE",
      "deleteAppDataOnUninstall": false,
      "artifactName": "VYBE-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cauan-Silva",
        "repo": "vybe",
        "releaseType": "release"
      }
    ]
  }
}
